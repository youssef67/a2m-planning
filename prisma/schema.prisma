generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id        String   @id @db.VarChar(64) // nanoid
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("sessions")
}

enum TypeOuvrier {
  SALARIE
  SOUS_TRAITANT
}

enum StatutOuvrier {
  ACTIF
  ARCHIVE
}

model Ouvrier {
  id        Int           @id @default(autoincrement())
  nom       String        @db.VarChar(100)
  prenom    String        @db.VarChar(100)
  type      TypeOuvrier
  statut    StatutOuvrier @default(ACTIF)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([statut])
  @@map("ouvriers")
}

enum StatutChantier {
  ACTIF
  EN_PAUSE
  TERMINE
}

model Chantier {
  id          Int            @id @default(autoincrement())
  nom         String         @db.VarChar(200)
  statut      StatutChantier @default(ACTIF)
  raisonPause String?        @db.VarChar(500)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([statut])
  @@map("chantiers")
}
